# Prefer docker login/credential helpers. If an env file is required, keep it
# outside the repository with mode 0600 (default: ~/.config/euripus-sports/images.env).
GHCR_USERNAME=
GHCR_TOKEN=

# Publishing image name. The publish script also emits a full Git SHA tag.
SPORTS_API_IMAGE=ghcr.io/olivermarcusson/euripus-sports-api

# Required deployment reference. A registry digest is preferred; a full 40-character
# Git SHA tag is also accepted by scripts/deploy-selfhosted.sh.
SPORTS_API_IMAGE_REF=ghcr.io/olivermarcusson/euripus-sports-api:0000000000000000000000000000000000000000

SPORTS_API_PORT=3000
SPORTS_API_SOURCE_FETCH_MODE=auto
SPORTS_API_BROWSER_COMMAND=chromium
SPORTS_API_REFRESH_INTERVAL=10m
SPORTS_API_READINESS_MAX_REFRESH_AGE=30m
